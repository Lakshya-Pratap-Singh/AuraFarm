# --- Notification system ---
# Any standard SMTP provider (Gmail app password, SendGrid, Mailgun,
# Resend's SMTP relay, etc). If SMTP_HOST is unset, email notifications
# are skipped silently and in-app notifications still work fine.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AuraFarm <no-reply@aurafarm.app>"
