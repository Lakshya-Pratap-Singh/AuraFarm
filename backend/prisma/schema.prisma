// =====================================================================
// AuraFarm — schema.prisma (COMPLETE FILE, ready to replace your real one)
// ---------------------------------------------------------------------
// Unlike the first pass at this (schema.additions.prisma, written before
// I had your real schema), this IS your actual schema.prisma with:
//   1. Priority/Difficulty/Category enum VALUES renamed to Title Case
//      (LOW→Low, MEDIUM→Medium, ... PHYSICAL→Physical, ...) — per your
//      decision, to match Missions.jsx rather than rewrite the frontend.
//   2. New Forge/Resource/Mission/ResourceSubmission models added.
//   3. New fields on User/Objective/Mission (all nullable/defaulted).
// Everything from your uploaded schema — Notification, NotificationTemplate,
// UserDevice, all existing fields — is preserved exactly.
//
// Apply via the migration in this same prisma/migrations/ folder (hand-
// written, NOT `prisma migrate dev`'s auto-diff — see that migration's
// header comment for why enum renames need to be hand-written).
// =====================================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  Low
  Medium
  High
}

enum Difficulty {
  Easy
  Normal
  Hard
  Legendary
}

enum Category {
  Physical
  Mental
  Career
  Learning
  Health
}

enum ActivityType {
  MISSION_CREATED
  MISSION_COMPLETED
  MISSION_REOPENED
  MISSION_DELETED
  OBJECTIVE_CREATED
  OBJECTIVE_UPDATED
  XP_EARNED
  XP_REVOKED
  // NEW
  MISSION_FORGED
}

enum NotificationType {
  MISSION_REMINDER
  MISSION_DUE_SOON
  MISSION_COMPLETED
  ACHIEVEMENT_UNLOCK
  OBJECTIVE_PROGRESS
  STREAK_WARNING
  DAILY_RESET
  WEEKLY_REPORT
  SYSTEM
}

enum NotificationChannel {
  APP
  EMAIL
  PUSH
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

/// Per-attempt delivery outcome, logged separately from the notification
/// itself so one Notification can fan out to multiple channels (APP row
/// always created instantly; EMAIL/PUSH attempted async) without losing
/// the audit trail of what was tried and what failed.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// --- NEW enums for the Forge/Resource/Mission system ---

enum Role {
  USER
  MODERATOR
  ADMIN
}

/// The Objective-level taxonomy from the AuraForge spec. Deliberately
/// separate from Mission `Category` above (5 values, mission-scoped) and
/// from the frontend's CATEGORY_ASSETS (11 values, mission-scoped,
/// currently ahead of what the DB/creation form support — see
/// migration-notes.md for that separate, unresolved discrepancy).
enum SuperCategory {
  PHYSICAL
  MENTAL
  CAREER
  FINANCIAL
  CREATIVE
  SOCIAL
  LIFESTYLE
}

enum ResourceType {
  EXERCISE
  ARTICLE
  BOOK
  VIDEO
  PDF
  EXTERNAL_LINK
  TEMPLATE
  OTHER
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  username     String         @unique
  passwordHash String
  totalXp      Int            @default(0)
  level        Int            @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  objectives   Objective[]
  missions     Mission[]
  xpEvents     XPEvent[]
  activityLogs ActivityEvent[]

  notifications Notification[]
  notificationTemplates NotificationTemplate[]
  devices UserDevice[]
  notificationPreference NotificationPreference?

  // --- NEW ---
  /// Required by the revived Firebase-auth middleware. Nullable so any
  /// existing rows created under the old JWT/bcrypt register flow (if
  /// any real users exist) aren't broken by this migration — they'd
  /// just need to sign in via Firebase once to get this populated
  /// (find-or-create in middleware/auth.js).
  firebaseUid String? @unique
  role Role @default(USER)

  resourceSubmissions    ResourceSubmission[]
  savedResources         SavedResource[]
  forgedMissionResources ResourceMission[]
  submittedResources     Resource[]
}

model Objective {
  id           String         @id @default(cuid())
  userId       String
  title        String
  description  String?
  progress     Int            @default(0)
  targetDate   DateTime?
  completed    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  missions     Mission[]
  activityLogs ActivityEvent[]

  // --- NEW ---
  superCategory SuperCategory?
  objectiveType String?         // e.g. "AESTHETIC_PHYSIQUE" — see forgeConfig.js;
                                 // plain String (not enum) so new objective types
                                 // are addable via config, no migration needed.
  progressBreakdown Json?       // cached Aura Growth breakdown; nullable, legacy
                                 // objectives keep using `progress` above untouched.

  resourceMissions ResourceMission[]
}

model Mission {
  id           String         @id @default(cuid())
  userId       String
  objectiveId  String?
  title        String
  completed    Boolean        @default(false)
  priority     Priority       @default(Medium)
  difficulty   Difficulty     @default(Normal)
  category     Category       @default(Learning)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective    Objective?     @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  xpEvents     XPEvent[]
  activityLogs ActivityEvent[]

  // --- NEW ---
  forgedFromResourceId String?
  forgedFromResource   Resource? @relation(fields: [forgedFromResourceId], references: [id])
  forgeParams Json?              // { sets, reps, duration, frequency, ... } — shape
                                  // varies per Forge type; null for non-forged missions.

  resourceMission ResourceMission?
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  missionId String?
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
}

model ActivityEvent {
  id           String      @id @default(cuid())
  userId       String
  missionId    String?
  objectiveId  String?
  type         ActivityType
  metadata     Json?
  createdAt    DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission      Mission?    @relation(fields: [missionId], references: [id], onDelete: SetNull)
  objective    Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
}

model Notification {
  id          String @id @default(cuid())

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  message     String

  type        NotificationType

  // --- NEW ---
  channel      NotificationChannel  @default(APP)
  priority     NotificationPriority @default(NORMAL)
  scheduledFor DateTime?            // null = deliver immediately
  deliveredAt  DateTime?            // set once the channel send actually succeeds

  isRead      Boolean @default(false)

  createdAt   DateTime @default(now())

  logs        NotificationLog[]

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([scheduledFor])
}

model NotificationTemplate {
  id          String @id @default(cuid())

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String

  // --- NEW --- optional display title, separate from the template's
  // own `name` (which is more like a label for the template picker,
  // e.g. "Gym Motivation" — matches the spec's Title/Message example).
  title       String?

  message     String

  type        NotificationType

  isDefault   Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, type])
}

model UserDevice {
  id          String @id @default(cuid())

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceToken String @unique

  deviceType  String // "web" | "android" | "ios"

  // --- NEW --- flipped false when FCM reports the token as
  // invalid/unregistered, instead of deleting the row outright.
  active      Boolean @default(true)

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

  @@index([userId, active])
}

/// One row per user. Created lazily (upsert) the first time a user
/// touches notification settings — absence of a row just means "all
/// defaults", so nothing else needs to special-case a missing row.
model NotificationPreference {
  id          String @id @default(cuid())

  userId      String @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Channel-level switches
  appEnabled   Boolean @default(true)
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(false)

  // Notification-type-level switches
  missionReminders  Boolean @default(true)
  achievementAlerts Boolean @default(true)
  weeklyReport      Boolean @default(true)
  dailySummary      Boolean @default(true)
  streakWarnings    Boolean @default(true)

  // "HH:mm" 24h local-time strings, interpreted against the user's
  // stored timezone (falls back to UTC if unset).
  reminderTime     String?
  quietHoursStart  String?
  quietHoursEnd    String?
  timezone         String  @default("UTC")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Per-channel delivery audit trail for a Notification. A single
/// Notification can have multiple logs (e.g. one APP row created
/// instantly + an EMAIL attempt logged async by the dispatcher).
model NotificationLog {
  id             String   @id @default(cuid())

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  error          String?

  createdAt      DateTime @default(now())

  @@index([notificationId])
  @@index([channel, status])
}

// =====================================================================
// NEW MODELS — Objective/Forge/Resource/Mission system
// =====================================================================

/// A Forge is a resource ecosystem under a Super Category (e.g.
/// "Exercise Forge" under PHYSICAL). Rows are seeded from
/// src/config/forgeConfig.js — see prisma/seed-forges.js.
model Forge {
  id            String        @id @default(cuid())
  key           String        @unique
  name          String
  superCategory SuperCategory
  description   String?
  icon          String?
  order         Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  resources Resource[]

  @@index([superCategory])
}

/// A single piece of content inside a Forge (an exercise, a book, an
/// article, etc.) that a user can save, learn from, or Forge into a
/// Mission.
model Resource {
  id          String          @id @default(cuid())
  forgeId     String
  forge       Forge           @relation(fields: [forgeId], references: [id])

  title       String
  description String?
  resourceType ResourceType
  difficulty  DifficultyLevel @default(BEGINNER)

  gifUrl      String?
  videoUrl    String?
  pdfUrl      String?
  externalUrl String?

  muscleGroup String?
  equipment   String?

  tags        String[]        @default([])

  verified    Boolean         @default(false)
  submittedBy String?
  submitter   User?           @relation(fields: [submittedBy], references: [id])

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  savedBy           SavedResource[]
  resourceMissions  ResourceMission[]
  forgedMissions    Mission[]
  submissionHistory ResourceSubmission[]

  @@index([forgeId])
  @@index([muscleGroup])
  @@index([verified])
}

/// A user's ⭐ Save Resource action — many-to-many User<->Resource.
model SavedResource {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

/// The relationship layer: Resource -> Mission -> Objective, plus which
/// user forged it.
model ResourceMission {
  id          String    @id @default(cuid())
  resourceId  String
  resource    Resource  @relation(fields: [resourceId], references: [id])
  missionId   String    @unique
  mission     Mission   @relation(fields: [missionId], references: [id])
  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([objectiveId])
  @@index([resourceId])
}

/// User-submitted resource pending moderation.
model ResourceSubmission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  resourceId  String?
  resource    Resource?        @relation(fields: [resourceId], references: [id])

  title       String
  description String?
  forgeId     String
  tags        String[]        @default([])
  gifUrl      String?
  videoUrl    String?
  pdfUrl      String?
  externalUrl String?

  status      SubmissionStatus @default(PENDING)
  reviewNotes String?
  reviewedBy  String?
  reviewedAt  DateTime?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([userId])
}
